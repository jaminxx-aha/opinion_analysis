# 舆情分析工具配置（仅 Claude Agent SDK 推理路径）
# 推理方式：headless Claude Code agent 加载抖音舆情 skill 做分类（单条问题→单次 agent 调用）
# 前置：pip install -r .claude/skills/opinion-analysis/scripts/requirements.txt ；并装好 claude CLI

# 模型 / API key / base_url
LLM_MODEL=glm-5.2
LLM_API_KEY=your-api-key-here
# 多 key 支持：逗号分隔，总并发 = key 数 × LLM_MAX_CONCURRENT；留空则回退 claude CLI 自身 OAuth 登录
# LLM_API_KEY=sk-key1,sk-key2,sk-key3
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 并发配置
# LLM_MAX_CONCURRENT: 每个_api_key 的最大并发数(总并发=key数×此值)
LLM_MAX_CONCURRENT=1

# Agent skill 配置
LLM_AGENT_SKILL_DIR=.                # 含 .claude/skills/<skill>/SKILL.md 的项目根目录（必填）
LLM_AGENT_SKILL_NAME=douyin-performance-problem-classifier
# LLM_AGENT_MAX_TURNS=10
# LLM_AGENT_TIMEOUT=120              # agent 单次调用超时(秒)，需多轮读 skill 文件故默认 120

# 其他可选配置
# LLM_MAX_RETRIES=3
# LLM_LOG_LEVEL=DEBUG

# 说明：skill 在 result 字段返回名称路径(如 "动效卡顿-滑动卡顿-页面滑动卡顿-视频流上下滑动卡顿")
#       或 "未知问题"；脚本校验其与编码树一致性并映射到数字编码，不在树里则重试→仍不行落「推理失败」(status=2)。
#       编码树见 references/apps/抖音/classification_function.md。

# 舆情分析工具配置（agent 后端推理路径）
# 推理方式：headless agent 加载应用舆情 skill 做分类（单条问题→单次 agent 调用）
# 后端二选一，由 LLM_AGENT_BACKEND 切换：
#   opencode（默认，通过 opencode-ai 驱动本地 opencode 服务，skill 作 system 注入）
#   openai（OpenAI SDK 直连 OpenAI 兼容端点，prompt 复刻历史 build_batch_prompt 模板）
# 前置：pip install -r .claude/skills/opinion-analysis/scripts/requirements.txt

# ========= 后端选择 =========
LLM_AGENT_BACKEND=opencode        # opencode | openai；切 OpenAI SDK 后端: LLM_AGENT_BACKEND=openai

# ========= 通用配置 =========
LLM_MAX_CONCURRENT=1            # 每个_api_key 的最大并发数(总并发=key数×此值)
# LLM_MAX_RETRIES=3
# LLM_LOG_LEVEL=DEBUG

# classifier skill 随应用目录收纳，无需配置 skill 路径：
#   references/apps/<app>/.claude/skills/performance-problem-classifier/SKILL.md
# 运行时按 --app-name 自动解析到对应应用目录。
# LLM_AGENT_MAX_TURNS=10
# LLM_AGENT_TIMEOUT=120           # agent 单次调用空闲超时(秒)，需多轮读 skill 文件故默认 120

# ========= opencode 后端专用（LLM_AGENT_BACKEND=opencode 时生效）=========
# provider/model 取自 opencode 配置（~/.config/opencode/opencode.json 的 provider 与其下 model）
LLM_AGENT_PROVIDER=bailian-payg
# LLM_AGENT_MODEL_ID=glm-5.2      # 可选，留空回退到 LLM_MODEL
# LLM_AGENT_MODE=ask              # ask(默认,只读问答) / build(带编辑工具)；分类建议 ask
# OPENCODE_BASE_URL=http://127.0.0.1:54321   # 已自建服务时填；不填则自动从 skill_dir 拉起
# LLM_MODEL=glm-5.2               # model_id 兜底回退（LLM_AGENT_MODEL_ID 未设时用此值；二者必填其一）

# ========= openai 后端专用（LLM_AGENT_BACKEND=openai 时生效）=========
# 复刻删除前 classify_batch.build_batch_prompt 单条版：注入 classification_function.md
# 作 CLASSIFICATION，返回 [{"classification":"编码","reason"}]。
# 需 LLM_MODEL / LLM_API_KEY / LLM_BASE_URL（见下方通用模型配置，openai 后端必填三者）。
# LLM_MODEL=glm-5.2
# LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MAX_TOKENS=1024             # 单次响应最大 token
# LLM_TEMPERATURE=0.7
# LLM_VERIFY_SSL=true             # false 时构造不校验证书的 http_client
# LLM_DISABLE_PROXY=false         # true 时 trust_env=False，不走系统代理
# LLM_ENABLE_THINKING=true        # 是否发 extra_body={"enable_thinking":true}；端点不支持时设 false

# 说明：
#   opencode 后端 skill 在 result 字段返回名称路径(如 "动效卡顿-滑动卡顿-页面滑动卡顿-视频流上下滑动卡顿")；
#   openai 后端在 classification 字段返回数字编码(如 "1.1.1"，可截断如 "1.1")。两者均会校验
#   与编码树一致性，不在树里则重试→仍不行落「推理失败」(status=2)。
#   分类树与 classifier skill 均置于 references/apps/<app>/ 下，按 --app-name 自动定位。

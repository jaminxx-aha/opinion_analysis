# 舆情分析工具配置（agent 后端推理路径）
# 推理方式：headless agent 加载抖音舆情 skill 做分类（单条问题→单次 agent 调用）
# 后端固定为 opencode（通过 opencode-ai 驱动本地 opencode 服务）
# 前置：pip install -r .claude/skills/opinion-analysis/scripts/requirements.txt

# ========= 通用配置 =========
LLM_MAX_CONCURRENT=1            # 每个_api_key 的最大并发数(总并发=key数×此值)
# LLM_MAX_RETRIES=3
# LLM_LOG_LEVEL=DEBUG

# Agent skill 配置（指向含 .claude/skills/<skill>/SKILL.md 的目录，必填）
LLM_AGENT_SKILL_DIR=test/mock_skill   # 该目录下需有 .claude/skills/<LLM_AGENT_SKILL_NAME>/SKILL.md
LLM_AGENT_SKILL_NAME=douyin-performance-problem-classifier
# LLM_AGENT_MAX_TURNS=10
# LLM_AGENT_TIMEOUT=120           # agent 单次调用空闲超时(秒)，需多轮读 skill 文件故默认 120

# ========= opencode 后端专用 =========
# provider/model 取自 opencode 配置（~/.config/opencode/opencode.json 的 provider 与其下 model）
LLM_AGENT_PROVIDER=bailian-payg
LLM_AGENT_MODEL_ID=glm-5.2        # 回退到 LLM_MODEL
# LLM_AGENT_MODE=ask              # ask(默认,只读问答) / build(带编辑工具)；分类建议 ask
# OPENCODE_BASE_URL=http://127.0.0.1:54321   # 已自建服务时填；不填则自动从 skill_dir 拉起
# LLM_MODEL=glm-5.2               # opencode model_id 的兜底回退（优先用 LLM_AGENT_MODEL_ID）

# 说明：skill 在 result 字段返回名称路径(如 "动效卡顿-滑动卡顿-页面滑动卡顿-视频流上下滑动卡顿")
#       或 "未知问题"；脚本校验其与编码树一致性并映射到数字编码，不在树里则重试→仍不行落「推理失败」(status=2)。
#       编码树见 references/apps/抖音/classification_function.md。

# LLM配置
# provider: API格式 (openai/anthropic)
LLM_PROVIDER=openai
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-api-key-here
# 多key支持: 用逗号分隔多个key, 如 LLM_API_KEY=sk-key1,sk-key2,sk-key3
# 总并发 = key数 × LLM_MAX_CONCURRENT
LLM_BASE_URL=https://api.deepseek.com/v1

# 并发配置
# LLM_MAX_CONCURRENT: 每个API key的最大并发数(总并发=key数×此值)
LLM_MAX_CONCURRENT=1
LLM_MAX_TOKENS=1024
LLM_BATCH_SIZE=1

# 推理模式: batch=批量一次性推导(默认,受 LLM_BATCH_SIZE 控制);
#           layered=逐层推导(每条问题按一级→二级→三级串行推导,LLM_BATCH_SIZE 不生效)
# LLM_REASON_MODE=layered

# 其他可选配置
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT=30
# LLM_TEMPERATURE=0.7
# LLM_VERIFY_SSL=true
# LLM_LOG_LEVEL=DEBUG
# LLM_DISABLE_PROXY=false

# ===== Claude Agent SDK provider（LLM_PROVIDER=claude-agent-sdk 时生效）=====
# 走 headless Claude Code agent 加载「抖音舆情分析」skill 做分类。
# skill 一次性返回完整分类编码 {classification, reason}，单条问题→单次 agent 调用。
# 需先安装：pip install claude-agent-sdk ；并装好 claude CLI。
# LLM_PROVIDER=claude-agent-sdk
# LLM_AGENT_SKILL_DIR=          # 含 .claude/skills/<skill>/SKILL.md 的项目根目录（必填）
# LLM_AGENT_SKILL_NAME=douyin-performance-problem-classifier
# LLM_AGENT_MODEL=claude-opus-4-8
# LLM_AGENT_API_KEY=            # Anthropic API key（留空则用 claude /login 的 OAuth 凭据）
# LLM_AGENT_BASE_URL=           # 可选，走代理时填
# LLM_AGENT_MAX_TURNS=10
# LLM_AGENT_TIMEOUT=120         # agent 单次调用超时(秒)，需多轮读 skill 文件故默认 120
# 注意：skill 在 result 字段返回名称路径(如 "动效卡顿-滑动卡顿-列表滑动卡顿-视频流上下滑动卡顿")
#       或 "未知问题"；脚本会校验其与编码树一致性并映射到数字编码，对不齐的尾部回退到最深有效上级，
#       仍无法匹配则该条落「推理失败」(status=2)。编码树见 references/apps/抖音/classification_function.md。
